# ============================================================================
# Variables del NAVEGADOR (prefijo VITE_)
# ============================================================================
# Todo lo que lleve el prefijo VITE_ acaba dentro del bundle y es visible para cualquiera
# que abra la aplicación. NUNCA pongas aquí un secreto de verdad.

VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co

# Clave de Google Maps (opcional).
# Sin ella la aplicación funciona igual: el selector de ubicación cae en modo manual
# (GPS del dispositivo + coordenadas escritas) y las rutas se abren por enlace en la app
# de Google Maps. Con ella aparecen los mapas incrustados y la búsqueda de direcciones.
#
# Es una clave de navegador: no se puede ocultar. Protégela en la consola de Google
# restringiéndola por dominio (HTTP referrers) y a las APIs "Maps JavaScript" y "Geocoding".
VITE_GOOGLE_MAPS_API_KEY=


# VITE_GOOGLE_MAPS_API_KEY es OPCIONAL: la clave de la empresa viene por defecto en
# src/utils/googleMaps.ts. Solo se define aquí para usar otra clave distinta.
#
# Se usa ÚNICAMENTE en el mapa de la ruta de cobro. Fijar la ubicación de la vivienda de un
# cliente no la necesita: toma las coordenadas del GPS del dispositivo o pegadas a mano.
#
# Una clave de Maps de navegador viaja en el bundle y no puede ser secreta. Restríngela en la
# consola de Google Cloud por referente HTTP (incluyendo localhost para desarrollo) y a la API
# "Maps JavaScript", y pon un límite de gasto. Si Google la rechaza, la aplicación lo detecta
# con `gm_authFailure` y lo dice en el mapa en vez de dejarlo en gris.

# ============================================================================
# Secretos del SERVIDOR — NO van en este archivo
# ============================================================================
# Estas variables las lee la Edge Function `jce-lookup` y se registran en Supabase, no en
# el repositorio ni en el navegador. TODAS SON OPCIONALES: el proveedor actual no pide clave
# y su URL viene por defecto en la función, así que basta con desplegarla.
#
#   supabase secrets set PERSONA_SEGURA_URL=https://psbi.me/persona.php   # solo si cambia
#   supabase secrets set PERSONA_SEGURA_KEY=<clave>                       # solo si la piden
#   supabase secrets set PERSONA_SEGURA_CACHE_DIAS=30
#   supabase secrets set PERSONA_SEGURA_TIMEOUT=8
#
# Si algún día el proveedor exige clave, PERSONA_SEGURA_KEY es un secreto real: si acaba en
# el navegador, cualquiera puede consultar la JCE con la cuenta de la empresa. Por eso la
# consulta pasa por la Edge Function aunque hoy no haya nada que ocultar — ahí es también
# donde se audita quien consulta (Ley 172-13) y donde se hashea la cédula.
